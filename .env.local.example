# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string
# Local dev with Docker: postgresql://coreaction:changeme@localhost:5432/coreaction_ml
# Cloud options: Neon (neon.tech), Supabase, Railway — all have free tiers
DATABASE_URL=postgresql://coreaction:changeme@localhost:5432/coreaction_ml

# ─── Auth ────────────────────────────────────────────────────────────────────
# Required — generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-secret-here

# Public URL of your deployment (no trailing slash)
NEXTAUTH_URL=http://localhost:3000

# Optional — override default seed credentials
# SEED_ADMIN_EMAIL=admin@ridecore.pro
# SEED_ADMIN_PASSWORD=CoreAction2026!

# ─── AI ──────────────────────────────────────────────────────────────────────
# Get yours at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# ─── Shopify Webhook (optional) ──────────────────────────────────────────────
# Get this from Shopify Admin → Settings → Notifications → Webhooks
# SHOPIFY_WEBHOOK_SECRET=your-shopify-webhook-secret

# ─── Email / Notifications (optional) ───────────────────────────────────────
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=noreply@ridecore.pro
# SMTP_PASS=your-smtp-password
# SMTP_FROM="Core Action ML <noreply@ridecore.pro>"
