# ─── Database ────────────────────────────────────────────────────────────────
# Default: SQLite — no server needed, works out of the box.
# File is stored at local.db in the project root.
DATABASE_URL="file:./local.db"

# For PostgreSQL (production / team): change schema.prisma provider to
# "postgresql" and use a connection string instead:
# DATABASE_URL=postgresql://user:password@host:5432/coreaction_ml

# ─── Auth ────────────────────────────────────────────────────────────────────
# Required — generate with: openssl rand -base64 32
# (start.sh / start.bat generates this automatically)
NEXTAUTH_SECRET=your-secret-here

# Public URL of your deployment (no trailing slash)
NEXTAUTH_URL=http://localhost:3000

# Optional — override default seed credentials
# SEED_ADMIN_EMAIL=admin@ridecore.pro
# SEED_ADMIN_PASSWORD=CoreAction2026!

# ─── AI ──────────────────────────────────────────────────────────────────────
# Get yours free at https://console.anthropic.com
# (start.sh / start.bat will prompt you for this on first run)
ANTHROPIC_API_KEY=

# ─── Shopify Integration ─────────────────────────────────────────────────────
# Optional — can also be entered in the app via Settings → Integrations
# SHOPIFY_STORE_DOMAIN=my-store.myshopify.com
# SHOPIFY_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# SHOPIFY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Veeqo Integration ───────────────────────────────────────────────────────
# Optional — can also be entered in the app via Settings → Integrations
# VEEQO_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Email / Notifications (optional) ───────────────────────────────────────
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=noreply@ridecore.pro
# SMTP_PASS=your-smtp-password
# SMTP_FROM="Core Action ML <noreply@ridecore.pro>"
