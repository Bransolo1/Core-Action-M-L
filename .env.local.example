# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string
# Local dev with Docker: postgresql://coreaction:changeme@localhost:5432/coreaction_ml
# Cloud options: Neon (neon.tech), Supabase, Railway — all have free tiers
DATABASE_URL=postgresql://coreaction:changeme@localhost:5432/coreaction_ml

# ─── Auth ────────────────────────────────────────────────────────────────────
# Required — generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-secret-here

# Public URL of your deployment (no trailing slash)
NEXTAUTH_URL=http://localhost:3000

# Optional — override default seed credentials
# SEED_ADMIN_EMAIL=admin@ridecore.pro
# SEED_ADMIN_PASSWORD=CoreAction2026!

# ─── AI ──────────────────────────────────────────────────────────────────────
# Get yours at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# ─── Shopify Integration ─────────────────────────────────────────────────────
# These are OPTIONAL — you can also enter credentials via the Integrations page
# in the app UI (stored in the database). Environment variables take priority.
#
# SHOPIFY_STORE_DOMAIN=my-store.myshopify.com
# SHOPIFY_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#   Get from: Shopify Admin → Apps → Develop apps → your app → API credentials
#
# SHOPIFY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#   Get from: Shopify Admin → Settings → Notifications → Webhooks → signing secret
#   Webhook URL to register in Shopify: https://your-domain.com/api/webhooks/shopify
#   Topic to register: orders/paid

# ─── Veeqo Integration ───────────────────────────────────────────────────────
# Also optional — can be entered in the Integrations page UI instead.
#
# VEEQO_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#   Get from: Veeqo → Settings → API → Generate API Key

# ─── Email / Notifications (optional) ───────────────────────────────────────
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=noreply@ridecore.pro
# SMTP_PASS=your-smtp-password
# SMTP_FROM="Core Action ML <noreply@ridecore.pro>"
