# ─── Database ────────────────────────────────────────────────────────────────
# SQLite (default — zero setup, file-based)
DATABASE_URL=file:./data/coreaction.db

# ─── Auth ────────────────────────────────────────────────────────────────────
# Required — auto-generated by start.sh, or generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-secret-here

# Public URL of your deployment (no trailing slash)
NEXTAUTH_URL=http://localhost:3000

# Optional — override default seed credentials
# SEED_ADMIN_EMAIL=admin@ridecore.pro
# SEED_ADMIN_PASSWORD=CoreAction2026!

# ─── AI ──────────────────────────────────────────────────────────────────────
# Get yours at https://console.anthropic.com
# ANTHROPIC_API_KEY=sk-ant-...

# ─── Shopify Webhook (optional) ──────────────────────────────────────────────
# SHOPIFY_WEBHOOK_SECRET=your-shopify-webhook-secret
